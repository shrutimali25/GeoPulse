# ==============================================================================
# GeoPulse Environment Configuration Template
# Copy this file to .env and populate with local/production values.
# NEVER commit the real .env file with secrets to version control.
# ==============================================================================

# Project Environment (development, staging, production)
GEOPULSE_ENV=development
LOG_LEVEL=INFO

# Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SPATIAL_DIR=./data/spatial

# Synthetic Data Generation Settings
DEFAULT_STUDY_ZONE=IND_BLR_KORAMANGALA
SIMULATION_DAYS=7
NUM_SIMULATED_DEVICES=500
SAMPLING_INTERVAL_SECONDS=30

# Snowflake Warehouse Credentials (Required for Stage 4)
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=GEOPULSE_DB
SNOWFLAKE_SCHEMA=RAW_STAGE

# Apache Spark / Sedona Settings
SPARK_APP_NAME=GeoPulse_Spatial_Processing
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
# Java / Hadoop path on Windows (if applicable)
# HADOOP_HOME=C:\hadoop

# Apache Airflow Settings
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# React / Kepler.gl Mapbox Token (Optional: Kepler works offline, but Mapbox basemaps need a token)
VITE_MAPBOX_API_TOKEN=your_mapbox_token_here
VITE_API_BASE_URL=http://localhost:8000
